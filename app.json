{
  "expo": {
    "name": "emoji-tycoon",
    "slug": "emoji-tycoon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whimsicalworks.emojitycoon",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "es",
          "de",
          "fr",
          "it",
          "nl",
          "nb",
          "da",
          "sv",
          "uk",
          "hi",
          "pt",
          "ja",
          "ko",
          "zh-Hans",
          "zh-Hant",
          "ru",
          "tr",
          "pl",
          "id",
          "ar",
          "vi",
          "th",
          "cs",
          "ro",
          "fi",
          "el",
          "hu",
          "sw",
          "bn",
          "fil"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.whimsicalworks.emojitycoon",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-localization"
    ]
  }
}