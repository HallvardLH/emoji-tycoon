{
  "expo": {
    "name": "Emoji Tycoon",
    "slug": "emoji-tycoon",
    "owner": "hallvardlh",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22154A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whimsicalworks.emojitycoon",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "es",
          "de",
          "fr",
          "it",
          "nl",
          "nb",
          "da",
          "sv",
          "uk",
          "hi",
          "pt",
          "ja",
          "ko",
          "zh-Hans",
          "zh-Hant",
          "ru",
          "tr",
          "pl",
          "id",
          "ar",
          "vi",
          "th",
          "cs",
          "ro",
          "fi",
          "el",
          "hu",
          "sw",
          "bn",
          "fil"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#22154A"
      },
      "package": "com.iagogames.emoji_tycoon",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5996643289244524~1864050818",
          "iosAppId": "ca-app-pub-5996643289244524~2471214614",
          "userTrackingUsageDescription": "Your data is used to show you ads that suit you better, which keeps Emoji Tycoon free.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "19abdfb7-d586-491a-b047-82dc48fb0f12"
      }
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5996643289244524~1864050818",
    "ios_app_id": "ca-app-pub-5996643289244524~2471214614"
  }
}
