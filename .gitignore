# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native
# Also listed in android/.gitignore, but EAS Build only reads this file. Uploading
# android/build sent autolinking.json with Windows paths, which broke the build
# Native folders are generated from app.json by prebuild (EAS runs it on every build)
/android/
/ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Google Play service account key for eas submit
/credentials/

# launch video output from /brag
brag-output/
